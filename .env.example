# Export these values yourself; the app does not automatically load .env.
# Bedrock requires your own authorised AWS identity and scoped role configuration.
BOT_BACKEND=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
AWS_REGION=us-east-1
# Required by the current configuration guard, including local Bedrock mode.
AWS_ROLE_ARN=
# Alternative RxDx backend: BOT_BACKEND=api and your own API key.
ANTHROPIC_API_KEY=
RATE_PER_HOUR=15
RATE_PER_DAY=400
